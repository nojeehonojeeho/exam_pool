{
  "workflow_id": "math-pdf-native-hwp-v12",
  "version": "1.0.0",
  "instructions": "docs/PDF_HWP_V12_ONE_REQUEST_WORK_INSTRUCTIONS.md",
  "traceability": "docs/PDF_HWP_V12_FEEDBACK_TRACEABILITY.md",
  "execution_kind": "agent_workflow_with_verified_adapters_not_universal_converter",
  "source_scope": "requested_problem_and_corresponding_solution_regions",
  "preserve_variant_ids": true,
  "paragraph_origin": "reviewed_semantic_blocks_not_ocr_rows",
  "style_precedence": ["explicit_user_reference", "requested_source_region_layout", "verified_default_editable_profile"],
  "default_style_file": "config/math_hwp_reference_style_v1.json",
  "source_review_dpi": 600,
  "high_risk_crop_dpi": 900,
  "render_review_min_dpi": 300,
  "endnotes": {
    "mode": "staged_atomic",
    "placement": "END_OF_DOCUMENT",
    "main_story": "all_questions_only_in_source_order",
    "body": "corresponding_answer_and_full_solution",
    "first_body": "next_physical_page_after_last_question_tail",
    "independent_boundary_review_required": true,
    "native_transfer_test_required": true,
    "same_content_revision_required": true
  },
  "deliverable_roles": ["question", "solution", "integrated_endnote"],
  "deliverable_formats": ["hwp", "hwpx"],
  "per_item_delivery_default": false,
  "evidence_separate_from_document_delivery": true,
  "missing_solution": "continue_question_work_no_invented_solution",
  "reuse": "dependency_hash_validated_affected_scope_only",
  "release": "all_required_evidence_closed_not_user_acceptance_alone",
  "com_parallelism": 1,
  "isolated_retry_after_cause_change": 1,
  "production_model_default": "gpt-5.6-luna",
  "production_reasoning_default": "max",
  "fast_mode": false,
  "service_tier": "default",
  "automatic_model_switch": false,
  "source_content_in_git": false
}
